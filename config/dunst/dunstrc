[global]
font = monospace 10
width = 330
height = 100
offset = 20x40
origin = top-right
frame_width = 2
frame_color = "#88C0D0"
separator_color = frame
corner_radius = 0
[urgency_low]
background = "#2E3440"
foreground = "#ECEFF4"
timeout = 5
[urgency_normal]
background = "#2E3440"
foreground = "#ECEFF4"
timeout = 7
[urgency_critical]
background = "#BF616A"
foreground = "#ECEFF4"
timeout = 0
