configuration {
 modi: "drun,run,window";
 show-icons: true;
 font: "monospace 11";
}
* {
 background: #2E3440;
 foreground: #ECEFF4;
 lightbg: #2E3440;
 lightfg: #ECEFF4;
 selected-normal-background: #88C0D0;
 selected-normal-foreground: #2E3440;
 selected-active-background: #88C0D0;
 selected-active-foreground: #2E3440;
 alternate-active-background: #2E3440;
 background-color: #2E3440;
 text-color: #ECEFF4;
}
window {
 background-color: #2E3440;
 padding: 8px;
 width: 40%;
 border: 2px;
 border-color: #88C0D0;
}
element normal.normal, element alternate.normal {
 background-color: #2E3440;
 text-color: #ECEFF4;
}
element selected {
 background-color: #88C0D0;
 text-color: #2E3440;
}
element-text, element-icon {
 background-color: transparent;
 text-color: inherit;
}
listview {
 lines: 8;
}
element {
 padding: 8px;
}
